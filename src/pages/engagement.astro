---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'engagement');
if (!page) throw new Error('Missing engagement page');
const { Content } = await render(page);

const settings = await getEntry('settings', 'site');
const { contact, person } = settings?.data ?? {};
---

<Base title={page.data.title} description={page.data.description}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{page.data.heading}</h1>
    <div class="prose">
      <Content />
    </div>

    <section class="engagement-section" id="research" aria-labelledby="research-heading">
      <h2 id="research-heading">Research collaboration</h2>
      <p>
        I collaborate with universities, research institutes, foundations, governments and international organizations on research concerning strategic technology and international security. Areas of particular interest include technology controls, AI and compute governance, research security, semiconductor supply chains, nuclear policy and the development of responsible analytical methods.
      </p>
      {contact?.academicEmail && (
        <p>
          <a href={`mailto:${contact.academicEmail}`} class="btn btn--secondary">Discuss research collaboration</a>
        </p>
      )}
      {!contact?.academicEmail && person?.linkedin && (
        <p>
          <a href={person.linkedin} class="btn btn--secondary external" rel="external noopener">Discuss research collaboration (LinkedIn)</a>
        </p>
      )}
    </section>

    <section class="engagement-section" id="speaking" aria-labelledby="speaking-heading">
      <h2 id="speaking-heading">Speaking and teaching</h2>
      <p>
        I contribute to academic seminars, executive programmes, professional training and public events. My teaching combines international-security scholarship, technical understanding and practical experience of policy implementation.
      </p>
      {person?.linkedin && (
        <p>
          <a href={person.linkedin} class="btn btn--secondary external" rel="external noopener">Speaking and teaching (LinkedIn)</a>
        </p>
      )}
    </section>

    <section class="engagement-section" id="advisory" aria-labelledby="advisory-heading">
      <h2 id="advisory-heading">Advisory work</h2>
      <p>
        Alongside my institutional research, I undertake selected advisory engagements with governments, companies, universities and international organizations through FusionLabs. This work focuses on strategic technology risk, export controls, research security, regulatory intelligence, training and AI-enabled analytical workflows.
      </p>
      <div class="btn-group">
        <ExternalLink href="https://www.fusionlabs.info/" class="btn btn--primary">Visit FusionLabs</ExternalLink>
        {contact?.advisoryEmail && (
          <a href={`mailto:${contact.advisoryEmail}`} class="btn btn--secondary">Email FusionLabs</a>
        )}
      </div>
    </section>

    <section class="engagement-section" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <p>
        For academic and research enquiries, {contact?.academicEmail ? <a href={`mailto:${contact.academicEmail}`}>{contact.academicEmail}</a> : <a href={person?.linkedin} class="external" rel="external noopener">please use LinkedIn</a>}. For advisory work, contact <a href={contact?.advisoryEmail ? `mailto:${contact.advisoryEmail}` : 'https://www.fusionlabs.info/'}>{contact?.advisoryEmail ? contact.advisoryEmail : 'FusionLabs'}</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .engagement-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }
</style>
