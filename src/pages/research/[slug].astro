---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import EssayCard from '../../components/EssayCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const themes = await getCollection('researchThemes', (t) => !t.data.draft);
  return themes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const themeId = entry.id;

const relatedPublications = await getCollection('publications', (p) => !p.data.draft && p.data.themes.includes(themeId));

const typeRank: Record<string, number> = {
  'Monograph': 0,
  'Edited volume': 1,
  'Peer-reviewed article': 2,
  'Major report': 3,
  'Policy paper': 4,
  'Book chapter': 5,
  'Professional article': 6,
  'Commentary': 7,
  'Essay': 8,
  'Institutional output': 9,
};

const sortedPublications = [...relatedPublications].sort((a, b) => {
  const aFeatured = a.data.featuredOnThemes.includes(themeId) ? 0 : 1;
  const bFeatured = b.data.featuredOnThemes.includes(themeId) ? 0 : 1;
  if (aFeatured !== bFeatured) return aFeatured - bFeatured;
  const aRank = typeRank[a.data.type] ?? 99;
  const bRank = typeRank[b.data.type] ?? 99;
  if (aRank !== bRank) return aRank - bRank;
  return (b.data.year ?? 0) - (a.data.year ?? 0);
});

const displayPublications = sortedPublications.slice(0, 8);
const hasMorePublications = relatedPublications.length > displayPublications.length;
const relatedProjects = (await getCollection('projects', (p) => !p.data.draft && p.data.themes.includes(themeId))).sort(
  (a, b) => a.data.order - b.data.order
);
const relatedEssays = (await getCollection('essays', (e) => !e.data.draft && e.data.themes.includes(themeId))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <Breadcrumbs items={[{ label: 'Research', href: '/research/' }, { label: entry.data.title, href: `/research/${themeId}/` }]} />

    <h1>{entry.data.title}</h1>
    <p class="proposition">{entry.data.proposition}</p>

    <div class="prose">
      <Content />
    </div>

    {entry.data.questions.length > 0 && (
      <section aria-labelledby="questions-heading" class="related-section">
        <h2 id="questions-heading">Central research questions</h2>
        <ul>
          {entry.data.questions.map((q) => (
            <li>{q}</li>
          ))}
        </ul>
      </section>
    )}

    {entry.data.topics.length > 0 && (
      <section aria-labelledby="topics-heading" class="related-section">
        <h2 id="topics-heading">Topics</h2>
        <ul class="topics-list">
          {entry.data.topics.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section aria-labelledby="projects-heading" class="related-section">
        <h2 id="projects-heading">Current or developing projects</h2>
        <div class="related-grid">
          {relatedProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )}

    {displayPublications.length > 0 && (
      <section aria-labelledby="publications-heading" class="related-section">
        <h2 id="publications-heading">Related books and publications</h2>
        {displayPublications.map((publication) => (
          <PublicationCard publication={publication} />
        ))}
        {hasMorePublications && (
          <p>
            <a href={`/publications/?theme=${themeId}`} class="btn btn--secondary">View all publications in this research area</a>
          </p>
        )}
      </section>
    )}

    {relatedEssays.length > 0 && (
      <section aria-labelledby="essays-heading" class="related-section">
        <h2 id="essays-heading">Related essays</h2>
        <div class="related-grid">
          {relatedEssays.map((essay) => (
            <EssayCard essay={essay} />
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="collaboration-heading" class="collaboration">
      <h2 id="collaboration-heading">Research collaboration</h2>
      <p>
        If you are interested in collaborating on research in this area, please see the <a href="/engagement/#research">engagement</a> page or contact me via <a href="https://www.linkedin.com/in/drianjstewart/">LinkedIn</a>.
      </p>
    </section>
  </div>
</Base>

<style>
  .proposition {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    color: var(--navy);
    max-width: var(--max-prose);
  }

  .related-section {
    margin-top: var(--space-2xl);
  }

  .topics-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
  }

  .topics-list li {
    border: 1px solid var(--border);
    padding: 0.2em 0.6em;
    border-radius: 999px;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-l);
  }

  .collaboration {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    background: #fff;
    border-left: 4px solid var(--copper);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
</style>
