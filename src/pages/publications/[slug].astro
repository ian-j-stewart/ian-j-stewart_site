---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PublicationMeta from '../../components/PublicationMeta.astro';
import PublicationActions from '../../components/PublicationActions.astro';
import { getCollection, render } from 'astro:content';
import { getThemeLabel } from '../../lib/themeLabels';

export async function getStaticPaths() {
  const publications = await getCollection('publications', (p) => !p.data.draft);
  return publications.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

function escapeHtml(str: string) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function citationToHtml(citation: string) {
  return citation
    .split('*')
    .map((part, index) =>
      index % 2 === 1 ? `<cite>${escapeHtml(part)}</cite>` : escapeHtml(part)
    )
    .join('');
}

function citationToPlain(citation: string) {
  return citation.replace(/\*/g, '');
}

const plainDescription = data.summary ?? (data.citation ? citationToPlain(data.citation) : undefined);
const typeToSchemaType: Record<string, string> = {
  'Monograph': 'Book',
  'Edited volume': 'Book',
  'Peer-reviewed article': 'ScholarlyArticle',
  'Book chapter': 'ScholarlyArticle',
  'Major report': 'Report',
  'Policy paper': 'Report',
  'Professional article': 'Article',
  'Commentary': 'Article',
  'Essay': 'Article',
  'Institutional output': 'Report',
};

const schemaType = typeToSchemaType[data.type] ?? 'Article';
const contributorProp = data.type === 'Edited volume' ? 'editor' : 'author';
const contributorNames = data.type === 'Edited volume' ? data.editors : (data.authors.length > 0 ? data.authors : data.editors);

let isPartOf: Record<string, unknown> | undefined = undefined;
if (data.venue) {
  if (data.type === 'Book chapter') {
    isPartOf = { '@type': 'Book', name: data.venue };
  } else if (['Peer-reviewed article', 'Professional article', 'Commentary', 'Essay'].includes(data.type)) {
    isPartOf = { '@type': 'Periodical', name: data.venue };
  }
}

const pageUrl = Astro.url.href;

const structuredData: Record<string, unknown> = {
  '@id': pageUrl,
  '@type': schemaType,
  name: data.title,
  [contributorProp]: contributorNames.map((name) => ({ '@type': 'Person', name })),
  datePublished: data.year ? String(data.year) : undefined,
  publisher: data.publisher ? { '@type': 'Organization', name: data.publisher } : undefined,
  identifier: data.doi ? `https://doi.org/${data.doi}` : undefined,
  url: pageUrl,
};

if (isPartOf) {
  structuredData.isPartOf = isPartOf;
}

---

<Base
  title={data.title}
  description={plainDescription ?? `Publication by Ian J. Stewart: ${data.title}`}
  pageType="article"
  pageStructuredData={structuredData}
>
  <div class="container" style="padding-block: var(--space-2xl);">
    <Breadcrumbs items={[{ label: 'Publications', href: '/publications/' }, { label: data.title, href: `/publications/${entry.id}/` }]} />

    <h1>{data.title}</h1>
    {data.subtitle && <p class="subtitle">{data.subtitle}</p>}

    <PublicationMeta publication={entry} />

    {data.doi && (
      <p class="publication-doi">
        <strong>DOI:</strong>
        <a href={`https://doi.org/${data.doi}`} class="external" rel="external noopener">{data.doi}</a>
      </p>
    )}

    {data.themes.length > 0 && (
      <p class="publication-themes">
        <strong>Themes:</strong>
        {data.themes.map((t, i) => (
          <>
            <a href={`/research/${t}/`}>{getThemeLabel(t)}</a>{i < data.themes.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )}

    <PublicationActions publication={entry} variant="detail" />

    {data.summary && (
      <div class="prose" style="margin-top: var(--space-xl);">
        <h2>Summary</h2>
        <p>{data.summary}</p>
      </div>
    )}

    {data.citation && (
      <div class="citation-box" style="margin-top: var(--space-xl);">
        <h2>Suggested citation</h2>
        <p class="citation" set:html={citationToHtml(data.citation)} />
      </div>
    )}

    {data.ianRole && (
      <p class="ian-role"><strong>Ian's role:</strong> {data.ianRole}</p>
    )}

    <div class="prose" style="margin-top: var(--space-xl);">
      <h2>Abstract</h2>
      <Content />
    </div>
  </div>
</Base>

<style>
  .subtitle {
    font-size: var(--step-1);
    color: var(--muted);
    font-style: italic;
    margin-top: calc(var(--space-xs) * -1);
  }

  .publication-doi,
  .publication-themes,
  .ian-role {
    font-size: var(--step--1);
    margin: var(--space-s) 0;
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin: var(--space-l) 0 var(--space-xl);
  }

  .citation-box {
    padding: var(--space-l);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .citation {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0;
  }
</style>
