---
import Base from '../layouts/Base.astro';
import { getEntry, getCollection, render } from 'astro:content';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchThemeCard from '../components/ResearchThemeCard.astro';

const page = await getEntry('pages', 'research');
if (!page) throw new Error('Missing research page');

const { Content } = await render(page);

const themes = (await getCollection('researchThemes', (t) => !t.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const methods = [
  'Policy and institutional analysis',
  'Historical and archival research',
  'Technical and supply-chain analysis',
  'Case studies',
  'Practitioner and stakeholder engagement',
  'AI-enabled open-source analysis',
  'Decision-support and implementation research',
];
---

<Base title={page.data.title} description={page.data.description}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{page.data.heading}</h1>
    <div class="prose">
      <Content />
    </div>
  </div>

  <section class="themes-section" aria-labelledby="themes-heading">
    <div class="container">
      <SectionHeading title="Research themes" id="themes-heading" />
      <div class="research-grid">
        {themes.map((theme) => (
          <ResearchThemeCard theme={theme} />
        ))}
      </div>
    </div>
  </section>

  <section class="frameworks-section" aria-labelledby="frameworks-heading">
    <div class="container">
      <SectionHeading
        title="Analytical frameworks"
        id="frameworks-heading"
        description="A recurring strand of my research develops explicit frameworks for assessing strategic-technology and international-security problems. These are intended to clarify concepts, expose assumptions and support comparison across technologies, actors and policy options."
      />
      <article class="framework-card card">
        <p class="framework-status">Version 1.0 · August 2026</p>
        <h3><a href="/strategic-technology-risk-control-framework/">Strategic Technology Risk & Control Framework</a></h3>
        <p>A methodology for moving from security concern to realistic policy objective, testing foreign availability and controllability, and selecting an appropriate control architecture.</p>
        <div class="framework-links">
          <a href="/strategic-technology-risk-control-framework/" class="btn btn--primary">Explore framework</a>
          <a href="/frameworks/" class="btn btn--secondary">View all frameworks</a>
        </div>
      </article>
    </div>
  </section>

  <section class="methods-section" aria-labelledby="methods-heading">
    <div class="container">
      <SectionHeading
        title="Implementation and analytical methods"
        id="methods-heading"
        description="A cross-cutting strand of my work examines how national-security policies are translated into organizational decisions and operational practice. This includes licensing, compliance, research governance, due diligence, supply-chain analysis and international capacity building. It also includes the development and evaluation of working prototypes for open-source analysis, knowledge representation, supply-chain research and expert decision support."
      />
      <p>
        <a href="/methods-and-tools/" class="btn btn--secondary">Explore methods and tools</a>
      </p>
      <ul class="methods-list">
        {methods.map((method) => (
          <li>{method}</li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .themes-section,
  .frameworks-section,
  .methods-section {
    padding-block: var(--space-2xl);
  }

  .themes-section {
    background: #fff;
    border-block: 1px solid var(--border);
  }

  .frameworks-section {
    border-bottom: 1px solid var(--border);
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }

  @media (min-width: 720px) {
    .research-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .framework-card {
    max-width: 58rem;
    margin-top: var(--space-l);
    border-left: 4px solid var(--copper);
  }

  .framework-card h3 {
    margin-top: 0;
    font-size: var(--step-2);
  }

  .framework-card h3 a {
    color: var(--navy);
    text-decoration: none;
  }

  .framework-card h3 a:hover,
  .framework-card h3 a:focus {
    color: var(--teal);
    text-decoration: underline;
  }

  .framework-status {
    color: var(--muted);
    font-size: var(--step--1);
    margin-bottom: var(--space-xs);
  }

  .framework-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .methods-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-s);
    list-style: none;
    padding: 0;
  }

  .methods-list li {
    padding: var(--space-s) var(--space-m);
    border-left: 3px solid var(--copper);
    background: #fff;
    border-radius: 0 var(--radius) var(--radius) 0;
  }
</style>
