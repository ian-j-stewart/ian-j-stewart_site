---
import Base from '../layouts/Base.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { getThemeLabel } from '../lib/themeLabels';

const pageTitle = 'Publications';
const pageDesc = 'Books, peer-reviewed articles, reports, analysis and commentary by Ian J. Stewart.';

const publications = (await getCollection('publications', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);

const themes = await getCollection('researchThemes', (t) => !t.data.draft);
const themeOptions = themes.map((t) => ({ slug: t.id, label: getThemeLabel(t.id) }));
const years = [...new Set(publications.map((p) => p.data.year).filter((y): y is number => y !== undefined))].sort((a, b) => b - a);

const published = publications.filter((p) => p.data.status === 'Published');
const current = publications.filter(
  (p) => p.data.status === 'Forthcoming' || p.data.status === 'Under contract' || p.data.status === 'In development'
);

const typeGroups: { label: string; match: (p: typeof publications[0]) => boolean }[] = [
  {
    label: 'Books',
    match: (p) => p.data.type === 'Monograph' || p.data.type === 'Edited volume',
  },
  {
    label: 'Peer-reviewed articles',
    match: (p) => p.data.type === 'Peer-reviewed article',
  },
  {
    label: 'Book chapters',
    match: (p) => p.data.type === 'Book chapter',
  },
  {
    label: 'Major reports and policy papers',
    match: (p) => p.data.type === 'Major report' || p.data.type === 'Policy paper',
  },
  {
    label: 'Selected professional writing and commentary',
    match: (p) =>
      p.data.type === 'Professional article' ||
      p.data.type === 'Commentary' ||
      p.data.type === 'Essay',
  },
  {
    label: 'Selected institutional and project outputs',
    match: (p) => p.data.type === 'Institutional output',
  },
];

const hasCv = existsSync('public/ian-j-stewart-cv.pdf');
---

<Base title={pageTitle} description={pageDesc}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{pageTitle}</h1>
    <p class="prose">
      This page brings together books, peer-reviewed research, major reports and selected policy analysis. Institutional products are listed separately from individually authored work.
    </p>

    {hasCv && (
      <p>
        <a href="/ian-j-stewart-cv.pdf" class="btn btn--secondary">Download academic CV</a>
      </p>
    )}

    <form class="filters" role="search" aria-label="Filter publications">
      <label class="filter-keyword">
        Search
        <input type="search" data-filter="keyword" placeholder="Search title, author, venue or summary" />
      </label>
      <label>
        Research theme
        <select data-filter="theme">
          <option value="">All themes</option>
          {themeOptions.map((t) => (
            <option value={t.slug}>{t.label}</option>
          ))}
        </select>
      </label>
      <label>
        Publication type
        <select data-filter="type">
          <option value="">All types</option>
          {[...new Set(publications.map((p) => p.data.type))].map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </label>
      <label>
        Year
        <select data-filter="year">
          <option value="">All years</option>
          {years.map((y) => (
            <option value={String(y)}>{y}</option>
          ))}
        </select>
      </label>
      <button type="button" class="btn btn--secondary" data-filter="clear">Clear filters</button>
    </form>

    <p class="results-count" aria-live="polite" data-results-count></p>
    <p class="no-results" data-no-results hidden>No publications match the selected filters.</p>

    <div class="publications-list" data-publications>
      {typeGroups.map((group) => {
        const items = published.filter((p) => group.match(p));
        if (items.length === 0) return null;
        const sectionId = `section-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
        return (
          <section class="pub-section" aria-labelledby={sectionId}>
            <h2 id={sectionId}>{group.label}</h2>
            <ul class="pub-items">
              {items.map((p) => (
                <li
                  data-publication-item
                  data-type={p.data.type}
                  data-year={p.data.year ?? ''}
                  data-themes={p.data.themes.join(',')}
                  data-current="false"
                  data-search={((p.data.title ?? '') + ' ' + (p.data.subtitle ?? '') + ' ' + (p.data.authors?.join(' ') ?? '') + ' ' + (p.data.venue ?? '') + ' ' + (p.data.publisher ?? '') + ' ' + (p.data.summary ?? '')).toLowerCase()}
                >
                  <PublicationCard publication={p} displayOnly />
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      {current.length > 0 && (
        <section class="pub-section" aria-labelledby="section-current">
          <h2 id="section-current">Current work</h2>
          <ul class="pub-items">
            {current.map((p) => (
              <li
                data-publication-item
                data-type={p.data.type}
                data-year={p.data.year ?? ''}
                data-themes={p.data.themes.join(',')}
                data-current="true"
                data-search={((p.data.title ?? '') + ' ' + (p.data.subtitle ?? '') + ' ' + (p.data.authors?.join(' ') ?? '') + ' ' + (p.data.venue ?? '') + ' ' + (p.data.publisher ?? '') + ' ' + (p.data.summary ?? '')).toLowerCase()}
              >
                <PublicationCard publication={p} displayOnly />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<script is:inline>
  (function () {
    const form = document.querySelector('[role="search"]');
    const keywordInput = document.querySelector('[data-filter="keyword"]');
    const themeSelect = document.querySelector('[data-filter="theme"]');
    const typeSelect = document.querySelector('[data-filter="type"]');
    const yearSelect = document.querySelector('[data-filter="year"]');
    const clearButton = document.querySelector('[data-filter="clear"]');
    const resultCount = document.querySelector('[data-results-count]');
    const noResults = document.querySelector('[data-no-results]');
    const list = document.querySelector('[data-publications]');
    const items = list ? list.querySelectorAll('[data-publication-item]') : [];
    const sections = document.querySelectorAll('[data-publications] .pub-section');

    function getFilterValues() {
      return {
        keyword: keywordInput ? keywordInput.value.trim().toLowerCase() : '',
        theme: themeSelect ? themeSelect.value : '',
        type: typeSelect ? typeSelect.value : '',
        year: yearSelect ? yearSelect.value : '',
      };
    }

    function setFilterValues(values) {
      if (keywordInput) keywordInput.value = values.keyword || '';
      if (themeSelect) themeSelect.value = values.theme || '';
      if (typeSelect) typeSelect.value = values.type || '';
      if (yearSelect) yearSelect.value = values.year || '';
    }

    function apply() {
      const { keyword, theme, type, year } = getFilterValues();
      let visibleCount = 0;

      items.forEach((item) => {
        const t = (item.getAttribute('data-themes') || '').split(',');
        const matchesTheme = !theme || t.includes(theme);
        const matchesType = !type || item.getAttribute('data-type') === type;
        const matchesYear = !year || item.getAttribute('data-year') === year;
        const matchesKeyword = !keyword || (item.getAttribute('data-search') || '').indexOf(keyword) !== -1;
        const isVisible = matchesTheme && matchesType && matchesYear && matchesKeyword;
        item.classList.toggle('is-hidden', !isVisible);
        if (isVisible) visibleCount++;
      });

      sections.forEach((section) => {
        const visibleItems = section.querySelectorAll('[data-publication-item]:not(.is-hidden)');
        section.classList.toggle('is-hidden', visibleItems.length === 0);
      });

      if (resultCount) {
        resultCount.textContent = visibleCount + (visibleCount === 1 ? ' publication' : ' publications');
      }
      if (noResults) {
        noResults.hidden = visibleCount > 0;
      }

      const params = new URLSearchParams();
      if (keyword) params.set('keyword', keyword);
      if (theme) params.set('theme', theme);
      if (type) params.set('type', type);
      if (year) params.set('year', year);
      const query = params.toString();
      const newUrl = query ? '?' + query : window.location.pathname;
      if (window.location.search !== (query ? '?' + query : '')) {
        window.history.replaceState({}, '', newUrl);
      }
    }

    function clear() {
      setFilterValues({ keyword: '', theme: '', type: '', year: '' });
      apply();
      if (keywordInput) keywordInput.focus();
    }

    function restoreFromQuery() {
      const params = new URLSearchParams(window.location.search);
      setFilterValues({
        keyword: params.get('keyword') || '',
        theme: params.get('theme') || '',
        type: params.get('type') || '',
        year: params.get('year') || '',
      });
    }

    if (form) form.addEventListener('input', apply);
    if (clearButton) clearButton.addEventListener('click', clear);
    restoreFromQuery();
    apply();
  })();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block: var(--space-l);
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .filters select {
    padding: 0.5em 0.75em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    font-size: var(--step-0);
    color: var(--charcoal);
  }

  .pub-section {
    margin-top: var(--space-2xl);
  }

  .pub-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .filters input[type="search"] {
    padding: 0.5em 0.75em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    font-size: var(--step-0);
    color: var(--charcoal);
    min-width: 18rem;
  }

  .filter-keyword {
    flex: 1 1 100%;
  }

  @media (min-width: 720px) {
    .filter-keyword {
      flex: 2 1 auto;
    }
  }

  .results-count {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: var(--space-s);
  }

  .no-results {
    margin-top: var(--space-l);
    padding: var(--space-l);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .pub-section.is-hidden,
  .pub-items li.is-hidden {
    display: none;
  }
</style>
