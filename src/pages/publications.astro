---
import Base from '../layouts/Base.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { getThemeLabel } from '../lib/themeLabels';

const pageTitle = 'Publications';
const pageDesc = 'Books, peer-reviewed articles, reports, analysis and commentary by Ian J. Stewart.';

const publications = (await getCollection('publications', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.year ?? 0) - (a.data.year ?? 0)
);

const themes = await getCollection('researchThemes', (t) => !t.data.draft);
const themeOptions = themes.map((t) => ({ slug: t.id, label: getThemeLabel(t.id) }));
const years = [...new Set(publications.map((p) => p.data.year).filter((y): y is number => y !== undefined))].sort((a, b) => b - a);

const published = publications.filter((p) => p.data.status === 'Published');
const current = publications.filter(
  (p) => p.data.status === 'Forthcoming' || p.data.status === 'Under contract' || p.data.status === 'In development'
);

const typeGroups: { label: string; match: (p: typeof publications[0]) => boolean }[] = [
  {
    label: 'Books',
    match: (p) => p.data.type === 'Monograph' || p.data.type === 'Edited volume',
  },
  {
    label: 'Peer-reviewed articles',
    match: (p) => p.data.type === 'Peer-reviewed article',
  },
  {
    label: 'Book chapters',
    match: (p) => p.data.type === 'Book chapter',
  },
  {
    label: 'Major reports and policy papers',
    match: (p) => p.data.type === 'Major report' || p.data.type === 'Policy paper',
  },
  {
    label: 'Selected professional writing and commentary',
    match: (p) =>
      p.data.type === 'Professional article' ||
      p.data.type === 'Commentary' ||
      p.data.type === 'Essay',
  },
  {
    label: 'Selected institutional and project outputs',
    match: (p) => p.data.type === 'Institutional output',
  },
];

const hasCv = existsSync('public/ian-j-stewart-cv.pdf');
---

<Base title={pageTitle} description={pageDesc}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{pageTitle}</h1>
    <p class="prose">
      This page brings together books, peer-reviewed research, major reports and selected policy analysis. Institutional products are listed separately from individually authored work.
    </p>

    {hasCv && (
      <p>
        <a href="/ian-j-stewart-cv.pdf" class="btn btn--secondary">Download academic CV</a>
      </p>
    )}

    <div class="filters" role="group" aria-label="Filter publications">
      <label>
        Research theme
        <select data-filter="theme">
          <option value="">All themes</option>
          {themeOptions.map((t) => (
            <option value={t.slug}>{t.label}</option>
          ))}
        </select>
      </label>
      <label>
        Publication type
        <select data-filter="type">
          <option value="">All types</option>
          {[...new Set(publications.map((p) => p.data.type))].map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </label>
      <label>
        Year
        <select data-filter="year">
          <option value="">All years</option>
          {years.map((y) => (
            <option value={String(y)}>{y}</option>
          ))}
        </select>
      </label>
    </div>

    <div class="publications-list" data-publications>
      {typeGroups.map((group) => {
        const items = published.filter((p) => group.match(p));
        if (items.length === 0) return null;
        const sectionId = `section-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
        return (
          <section class="pub-section" aria-labelledby={sectionId}>
            <h2 id={sectionId}>{group.label}</h2>
            <ul class="pub-items">
              {items.map((p) => (
                <li
                  data-type={p.data.type}
                  data-year={p.data.year ?? ''}
                  data-themes={p.data.themes.join(',')}
                  data-current="false"
                >
                  <PublicationCard publication={p} displayOnly />
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      {current.length > 0 && (
        <section class="pub-section" aria-labelledby="section-current">
          <h2 id="section-current">Current work</h2>
          <ul class="pub-items">
            {current.map((p) => (
              <li
                data-type={p.data.type}
                data-year={p.data.year ?? ''}
                data-themes={p.data.themes.join(',')}
                data-current="true"
              >
                <PublicationCard publication={p} displayOnly />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<script is:inline>
  (function () {
    const selects = document.querySelectorAll('[data-filter]');
    const items = document.querySelectorAll('[data-publications] li');
    if (!selects.length || !items.length) return;

    function getValue(name) {
      const el = document.querySelector('[data-filter="' + name + '"]');
      return el ? el.value : '';
    }

    function apply() {
      const theme = getValue('theme');
      const type = getValue('type');
      const year = getValue('year');

      items.forEach((item) => {
        const t = (item.getAttribute('data-themes') || '').split(',');
        const matchesTheme = !theme || t.includes(theme);
        const matchesType = !type || item.getAttribute('data-type') === type;
        const matchesYear = !year || item.getAttribute('data-year') === year;
        item.classList.toggle('is-hidden', !(matchesTheme && matchesType && matchesYear));
      });
    }

    selects.forEach((select) => select.addEventListener('change', apply));
    apply();
  })();
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block: var(--space-l);
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  .filters select {
    padding: 0.5em 0.75em;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #fff;
    font-size: var(--step-0);
    color: var(--charcoal);
  }

  .pub-section {
    margin-top: var(--space-2xl);
  }

  .pub-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pub-items li.is-hidden {
    display: none;
  }
</style>
