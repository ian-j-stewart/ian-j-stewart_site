---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { getEntry, render } from 'astro:content';
import { existsSync } from 'node:fs';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page');
const { Content } = await render(page);
const hasCv = existsSync('public/ian-j-stewart-cv.pdf');
---

<Base title={page.data.title} description={page.data.description}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{page.data.heading}</h1>

    <div class="prose">
      <Content />
    </div>

    <section class="about-section" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading">Career timeline</h2>
      <ol class="timeline">
        <li><strong>UK Ministry of Defence</strong> — Nuclear engineer and assessor</li>
        <li><strong>Project Alpha, King’s College London</strong> — Founder and head</li>
        <li><strong>James Martin Center for Nonproliferation Studies, Washington, DC</strong> — Executive Director</li>
        <li><strong>FusionLabs</strong> — Advisory work</li>
      </ol>
    </section>

    <section class="about-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ul>
        <li>PhD in War Studies, King’s College London</li>
        <li>MSc in Nuclear Science and Technology</li>
        <li>Master’s-level qualification in Electrical and Electronic Engineering</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="books-heading">
      <h2 id="books-heading">Books</h2>
      <ul>
        <li><em>International Nuclear Export Controls and Non-Proliferation: The Collective Action Problem</em> (Routledge, 2022)</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="research-leadership-heading">
      <h2 id="research-leadership-heading">Research leadership</h2>
      <ul>
        <li>More than 25 funded projects led or managed</li>
        <li>More than $20 million in funded activity led or managed</li>
        <li>Established and led Project Alpha at King’s College London</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Selected institutional experience</h2>
      <ul>
        <li>Executive Director, Washington, DC office, James Martin Center for Nonproliferation Studies</li>
        <li>United Kingdom Ministry of Defence</li>
        <li>King’s College London</li>
      </ul>
    </section>

    {hasCv && (
      <section class="about-section" aria-labelledby="cv-heading">
        <h2 id="cv-heading">CV</h2>
        <p>
          <a href="/ian-j-stewart-cv.pdf" class="btn btn--secondary">Download academic CV</a>
        </p>
      </section>
    )}

    <section class="about-section" aria-labelledby="profiles-heading">
      <h2 id="profiles-heading">External profiles</h2>
      <ul class="profile-links">
        <li><ExternalLink href="https://www.linkedin.com/in/drianjstewart/">LinkedIn</ExternalLink></li>
        <li><ExternalLink href="https://nonproliferation.org/people/ian-stewart">CNS</ExternalLink></li>
        <li><ExternalLink href="https://www.fusionlabs.info/">FusionLabs</ExternalLink></li>
        <li><ExternalLink href="https://www.nonproarchive.com/">Nonproliferation Archive</ExternalLink></li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .about-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline li {
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--border);
  }

  .timeline li:last-child {
    border-bottom: none;
  }

  .profile-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }
</style>
