---
import Base from '../layouts/Base.astro';
import ExternalLink from '../components/ExternalLink.astro';
import { getEntry, getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page');
const { Content } = await render(page);
const hasCv = existsSync('public/ian-j-stewart-cv.pdf');

const settings = await getEntry('settings', 'site');
const themes = (await getCollection('researchThemes', (t) => !t.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const { person, institution } = settings?.data ?? {};
---

<Base title={page.data.title} description={page.data.description}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{page.data.heading}</h1>

    <div class="prose">
      <Content />
    </div>

    <section class="about-section" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <ul>
        <li>PhD in War Studies, King’s College London</li>
        <li>MSc in Nuclear Science and Technology</li>
        <li>MEng in Electrical and Electronic Engineering</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="books-heading">
      <h2 id="books-heading">Books</h2>
      <ul>
        <li><em><a href="/publications/international-nuclear-export-controls-and-non-proliferation/">International Nuclear Export Controls and Non-Proliferation: The Collective Action Problem</a></em> (Routledge, 2022) — author</li>
        <li><em><a href="/publications/preventing-the-proliferation-of-wmds/">Preventing the Proliferation of WMDs: Measuring the Success of UN Security Council Resolution 1540</a></em>, edited by Daniel Salisbury, Ian J. Stewart and Andrea Viski (Palgrave Pivot, 2018) — co-editor</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="research-areas-heading">
      <h2 id="research-areas-heading">Current research areas</h2>
      <ul>
        {themes.map((theme) => (
          <li><a href={`/research/${theme.id}/`}>{theme.data.title}</a></li>
        ))}
      </ul>
    </section>

    <section class="about-section" aria-labelledby="research-leadership-heading">
      <h2 id="research-leadership-heading">Research leadership</h2>
      <ul>
        <li>More than 25 funded projects led or managed</li>
        <li>More than $20 million in funded activity led or managed</li>
        <li>Founder and former head of Project Alpha, King’s College London</li>
      </ul>
    </section>

    <section class="about-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Selected institutional experience</h2>
      <ul>
        <li>Executive Director, Washington, DC office, James Martin Center for Nonproliferation Studies</li>
        <li>United Kingdom Ministry of Defence — nuclear engineer and assessor</li>
        <li>Project Alpha, King’s College London — founder and former head</li>
      </ul>
    </section>

    {hasCv && (
      <section class="about-section" aria-labelledby="cv-heading">
        <h2 id="cv-heading">CV</h2>
        <p>
          <a href="/ian-j-stewart-cv.pdf" class="btn btn--secondary">Download CV</a>
        </p>
      </section>
    )}

    <section class="about-section" aria-labelledby="profiles-heading">
      <h2 id="profiles-heading">External profiles</h2>
      <ul class="profile-links">
        {person?.linkedin && (
          <li><ExternalLink href={person.linkedin}>LinkedIn</ExternalLink></li>
        )}
        {person?.cns && (
          <li><ExternalLink href={person.cns}>CNS expert page</ExternalLink></li>
        )}
        {institution?.url && (
          <li><ExternalLink href={institution.url}>Institutional profile</ExternalLink></li>
        )}
        {person?.fusionlabs && (
          <li><ExternalLink href={person.fusionlabs}>FusionLabs</ExternalLink></li>
        )}
        {person?.nonproarchive && (
          <li><ExternalLink href={person.nonproarchive}>Nonproliferation Archive</ExternalLink></li>
        )}
      </ul>
    </section>
  </div>
</Base>

<style>
  .about-section {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline li {
    padding: var(--space-s) 0;
    border-bottom: 1px solid var(--border);
  }

  .timeline li:last-child {
    border-bottom: none;
  }

  .profile-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
  }
</style>
