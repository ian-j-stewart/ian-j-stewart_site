---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagList from '../../components/TagList.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import EssayCard from '../../components/EssayCard.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const statusLabel = data.status === 'Developing' ? 'Developing research agenda' : data.status;

const allPublications = await getCollection('publications', (p) => !p.data.draft);
const allEssays = await getCollection('essays', (e) => !e.data.draft);

const relatedPublications = data.relatedPublications
  .map((id) => allPublications.find((p) => p.id === id))
  .filter((p): p is (typeof allPublications)[0] => !!p);
const relatedEssays = data.relatedEssays
  .map((id) => allEssays.find((e) => e.id === id))
  .filter((e): e is (typeof allEssays)[0] => !!e);
---

<Base title={data.title} description={data.summary}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <Breadcrumbs items={[{ label: 'Current Research', href: '/projects/' }, { label: data.title, href: `/projects/${entry.id}/` }]} />

    <h1>{data.title}</h1>
    <p class="status">{statusLabel}</p>
    <p class="summary">{data.proposition ?? data.summary}</p>

    {data.themes.length > 0 && (
      <TagList tags={data.themes} />
    )}

    <div class="prose" style="margin-top: var(--space-2xl);">
      <Content />
    </div>

    {data.questions.length > 0 && (
      <section class="related-section" aria-labelledby="questions-heading">
        <h2 id="questions-heading">Central questions</h2>
        <ul>
          {data.questions.map((q) => (
            <li>{q}</li>
          ))}
        </ul>
      </section>
    )}

    {relatedPublications.length > 0 && (
      <section class="related-section" aria-labelledby="publications-heading">
        <h2 id="publications-heading">Related publications</h2>
        {relatedPublications.map((publication) => (
          <PublicationCard publication={publication} displayOnly />
        ))}
      </section>
    )}

    {relatedEssays.length > 0 && (
      <section class="related-section" aria-labelledby="essays-heading">
        <h2 id="essays-heading">Related essays</h2>
        <div class="related-grid">
          {relatedEssays.map((essay) => (
            <EssayCard essay={essay} />
          ))}
        </div>
      </section>
    )}

    <section class="collaboration" aria-labelledby="collaboration-heading">
      <h2 id="collaboration-heading">Research collaboration</h2>
      <p>
        If you are interested in this research area, see the <a href="/engagement/#research">engagement</a> page or get in touch via <a href="https://www.linkedin.com/in/drianjstewart/" class="external" rel="external noopener">LinkedIn</a>.
      </p>
    </section>

    {(entry.data.outputs.length > 0 || entry.data.links.length > 0) && (
      <aside class="project-meta">
        {entry.data.outputs.length > 0 && (
          <div>
            <h2>Outputs and activities</h2>
            <ul>
              {entry.data.outputs.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </div>
        )}
        {entry.data.links.length > 0 && (
          <div>
            <h2>Links</h2>
            <ul>
              {entry.data.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    )}
  </div>
</Base>

<style>
  .status {
    font-weight: 500;
    color: var(--copper);
    margin-top: 0;
    margin-bottom: var(--space-s);
  }

  .summary {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--max-prose);
  }

  .related-section {
    margin-top: var(--space-2xl);
  }

  .related-section h2 {
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-l);
  }

  .collaboration {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    background: #fff;
    border-left: 4px solid var(--copper);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .project-meta {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .project-meta h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
</style>
