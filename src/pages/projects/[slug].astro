---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TagList from '../../components/TagList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <Breadcrumbs items={[{ label: 'Projects', href: '/projects/' }, { label: entry.data.title, href: `/projects/${entry.id}/` }]} />

    <h1>{entry.data.title}</h1>
    <p class="status">{entry.data.status}</p>
    <p class="summary">{entry.data.summary}</p>

    {entry.data.themes.length > 0 && (
      <TagList tags={entry.data.themes} />
    )}

    <div class="prose" style="margin-top: var(--space-2xl);">
      <Content />
    </div>

    {(entry.data.collaborators.length > 0 || entry.data.funder || entry.data.outputs.length > 0 || entry.data.links.length > 0) && (
      <aside class="project-meta">
        {entry.data.collaborators.length > 0 && (
          <div>
            <h2>Collaborators</h2>
            <p>{entry.data.collaborators.join(', ')}</p>
          </div>
        )}
        {entry.data.funder && (
          <div>
            <h2>Funder</h2>
            <p>{entry.data.funder}</p>
          </div>
        )}
        {entry.data.outputs.length > 0 && (
          <div>
            <h2>Outputs</h2>
            <ul>
              {entry.data.outputs.map((o) => (
                <li>{o}</li>
              ))}
            </ul>
          </div>
        )}
        {entry.data.links.length > 0 && (
          <div>
            <h2>Links</h2>
            <ul>
              {entry.data.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    )}
  </div>
</Base>

<style>
  .status {
    font-weight: 500;
    color: var(--copper);
    margin-top: 0;
    margin-bottom: var(--space-s);
  }

  .summary {
    font-size: var(--step-1);
    color: var(--muted);
    max-width: var(--max-prose);
  }

  .project-meta {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .project-meta h2 {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }
</style>
