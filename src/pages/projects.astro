---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Current Research';
const pageDesc = 'Current research connecting international-security scholarship with the institutional and technical challenges involved in governing strategic technologies.';

const allProjects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const statusOrder = ['Current', 'Developing', 'Completed'];
const byStatus = statusOrder.map((status) => ({
  status,
  items: allProjects.filter((p) => p.data.status === status),
}));

const statusLabel: Record<string, string> = {
  'Current': 'Current research agenda',
  'Developing': 'Developing research agenda',
  'Completed': 'Completed research',
};
---

<Base title={pageTitle} description={pageDesc}>
  <div class="container" style="padding-block: var(--space-2xl);">
    <h1>{pageTitle}</h1>
    <p class="prose">My current research connects international-security scholarship with the institutional and technical challenges involved in governing strategic technologies.</p>

    {byStatus.map((group) =>
      group.items.length > 0 ? (
        <section class="project-section" aria-labelledby={`status-${group.status.toLowerCase()}`}>
          <h2 id={`status-${group.status.toLowerCase()}`} class="section-status">{statusLabel[group.status] ?? group.status}</h2>
          <div class="project-grid">
            {group.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      ) : null
    )}
  </div>
</Base>

<style>
  .section-status {
    font-size: var(--step-2);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-l);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-l);
  }
</style>
