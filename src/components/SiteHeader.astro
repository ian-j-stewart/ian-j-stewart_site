---
import type { CollectionEntry } from 'astro:content';

interface Props {
  settings: CollectionEntry<'settings'>;
}

const { settings } = Astro.props;
const { navigation } = settings.data;
const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const base = href.replace(/\/+$/, '');
  const current = currentPath.replace(/\/+$/, '');
  if (base === '') return current === '';
  return current === base || current.startsWith(base + '/');
}

function itemIsActive(item: (typeof navigation)[number]) {
  return isActive(item.href) || item.children?.some((child) => isActive(child.href)) || false;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-title" href="/" aria-label="Ian J. Stewart home" aria-current={currentPath === '/' ? 'page' : undefined}>Ian J. Stewart</a>

    <button
      class="menu-toggle"
      type="button"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Toggle navigation"
      data-menu-toggle
    >
      <span aria-hidden="true">Menu</span>
    </button>

    <nav id="primary-nav" class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {navigation.map((item) => {
          const active = itemIsActive(item);
          const hasChildren = Boolean(item.children?.length);
          return (
            <li class={hasChildren ? 'nav-item nav-item--has-children' : 'nav-item'}>
              <a href={item.href} class={`nav-link ${active ? 'nav-link--current' : ''}`} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              {hasChildren && (
                <ul class="subnav" aria-label={`${item.label} submenu`}>
                  {item.children?.map((child) => {
                    const childActive = isActive(child.href);
                    return (
                      <li>
                        <a href={child.href} class={childActive ? 'subnav-link subnav-link--current' : 'subnav-link'} aria-current={childActive ? 'page' : undefined}>{child.label}</a>
                      </li>
                    );
                  })}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    const toggle = document.querySelector('[data-menu-toggle]');
    const nav = document.getElementById('primary-nav');
    if (!toggle || !nav) return;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Toggle navigation');
      nav.classList.toggle('is-open', open);
      if (open) {
        const firstLink = nav.querySelector('a');
        if (firstLink) firstLink.focus();
      } else {
        toggle.focus();
      }
    }

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
      }
    });

    document.addEventListener('click', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!nav.contains(target) && !toggle.contains(target)) {
        setOpen(false);
      }
    });
  })();
</script>

<style>
  .site-header {
    background: var(--navy);
    color: var(--off-white);
    padding-block: var(--space-m);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .site-title {
    color: var(--off-white);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 600;
    text-decoration: none;
  }

  .site-title:hover,
  .site-title:focus {
    color: var(--copper);
  }

  .menu-toggle {
    display: block;
    background: transparent;
    color: var(--off-white);
    border: 1.5px solid var(--off-white);
    border-radius: var(--radius);
    padding: 0.4em 0.8em;
    font-size: var(--step--1);
    cursor: pointer;
  }

  .site-nav {
    width: 100%;
    display: none;
  }

  .site-nav.is-open {
    display: block;
  }

  .nav-list,
  .subnav {
    list-style: none;
    padding: 0;
  }

  .nav-list {
    margin: var(--space-m) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .nav-item > a,
  .subnav a {
    color: var(--off-white);
    text-decoration: none;
    display: inline-block;
  }

  .nav-item > a {
    font-size: var(--step-1);
    padding: 0.25em 0;
  }

  .subnav {
    margin: 0.25rem 0 0 var(--space-m);
    display: grid;
    gap: 0.35rem;
  }

  .subnav a {
    font-size: var(--step--1);
    color: #e7e6e2;
    padding: 0.2em 0;
  }

  .nav-item a:hover,
  .nav-item a:focus,
  .subnav-link--current,
  .nav-link--current {
    color: var(--copper);
    text-decoration: underline;
  }

  .nav-link--current {
    font-weight: 500;
  }

  .site-title[aria-current="page"] {
    color: var(--copper);
  }

  @media (min-width: 760px) {
    .menu-toggle {
      display: none;
    }

    .site-nav {
      width: auto;
      display: block;
    }

    .nav-list {
      flex-direction: row;
      align-items: center;
      gap: var(--space-l);
      margin: 0;
    }

    .nav-item {
      position: relative;
    }

    .nav-item > a {
      font-size: var(--step--1);
      white-space: nowrap;
    }

    .subnav {
      display: none;
      position: absolute;
      top: calc(100% + 0.45rem);
      left: 50%;
      transform: translateX(-50%);
      min-width: 19rem;
      margin: 0;
      padding: var(--space-s);
      background: var(--navy);
      border: 1px solid rgba(255,255,255,0.18);
      border-radius: var(--radius);
      box-shadow: 0 10px 24px rgba(0,0,0,0.18);
      z-index: 50;
    }

    .nav-item--has-children:hover .subnav,
    .nav-item--has-children:focus-within .subnav {
      display: grid;
    }

    .subnav a {
      display: block;
      padding: 0.55rem 0.65rem;
      line-height: 1.35;
    }
  }
</style>
