---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import PublicationMeta from './PublicationMeta.astro';
import PublicationActions from './PublicationActions.astro';

interface Props {
  publication: CollectionEntry<'publications'>;
  showAbstract?: boolean;
  displayOnly?: boolean;
}

const { publication, showAbstract = false, displayOnly = false } = Astro.props;
const { title, subtitle, summary, themes } = publication.data;
const detailUrl = `/publications/${publication.id}/`;
---

<article class="card publication-card">
  <h3 class="publication-title">
    <a href={detailUrl}>{title}</a>
  </h3>
  {subtitle && <p class="publication-subtitle">{subtitle}</p>}

  <PublicationMeta publication={publication} />

  {summary && <p class="publication-summary">{summary}</p>}
  {showAbstract && <div class="publication-abstract"><slot /></div>}

  {themes.length > 0 && <TagList tags={themes} />}

  {!displayOnly && (
    <PublicationActions publication={publication} detailUrl={detailUrl} variant="card" />
  )}
</article>

<style>
  .publication-card {
    margin-bottom: var(--space-l);
  }

  .publication-title {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .publication-title a {
    color: var(--navy);
    text-decoration: none;
  }

  .publication-title a:hover,
  .publication-title a:focus {
    color: var(--teal);
    text-decoration: underline;
  }

  .publication-subtitle {
    color: var(--muted);
    font-style: italic;
    margin: var(--space-xs) 0;
  }

  .publication-summary {
    margin-top: var(--space-s);
    color: var(--charcoal);
  }

  .publication-abstract {
    margin-top: var(--space-s);
    color: var(--charcoal);
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .btn--small {
    padding: 0.4em 0.75em;
    font-size: var(--step--1);
  }
</style>
