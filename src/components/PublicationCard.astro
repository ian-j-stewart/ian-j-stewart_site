---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';

interface Props {
  publication: CollectionEntry<'publications'>;
  showAbstract?: boolean;
  displayOnly?: boolean;
}

const { publication, showAbstract = false, displayOnly = false } = Astro.props;
const { title, subtitle, authors, year, type, venue, volume, issue, pages, publisher, summary, externalUrl, publisherUrl, pdfUrl, doi, status, themes } = publication.data;
const detailUrl = `/publications/${publication.id}/`;
const showPublisher = publisher && publisher !== venue;
---

<article class="card publication-card">
  <h3 class="publication-title">
    <a href={detailUrl}>{title}</a>
  </h3>
  {subtitle && <p class="publication-subtitle">{subtitle}</p>}

  <p class="publication-meta">
    {authors.length > 0 && <span class="publication-authors">{authors.join(', ')}</span>}
    {year && <span class="publication-year">{year}</span>}
    <span class="publication-type">{type}</span>
    {status && status !== 'Published' && <span class="publication-status">{status}</span>}
  </p>

  {(venue || publisher) && (
    <p class="publication-venue">
      {venue && <em>{venue}</em>}
      {volume && <span>{volume}</span>}
      {issue && <span>({issue})</span>}
      {pages && <span>{pages}</span>}
      {showPublisher && <span>{publisher}</span>}
    </p>
  )}

  {summary && <p class="publication-summary">{summary}</p>}
  {showAbstract && <div class="publication-abstract"><slot /></div>}

  {themes.length > 0 && <TagList tags={themes} />}

  {!displayOnly && (
    <div class="publication-actions">
      <a href={detailUrl} class="btn btn--secondary btn--small">View publication</a>
      {externalUrl && <a href={externalUrl} class="external btn btn--secondary btn--small" rel="external noopener">Read full text</a>}
      {!externalUrl && pdfUrl && <a href={pdfUrl} class="external btn btn--secondary btn--small" rel="external noopener">Read full text</a>}
      {publisherUrl && <a href={publisherUrl} class="external btn btn--secondary btn--small" rel="external noopener">Publisher page</a>}
      {doi && <a href={`https://doi.org/${doi}`} class="external btn btn--secondary btn--small" rel="external noopener">DOI</a>}
      {pdfUrl && <a href={pdfUrl} class="external btn btn--secondary btn--small" rel="external noopener">Download PDF</a>}
    </div>
  )}
</article>

<style>
  .publication-card {
    margin-bottom: var(--space-l);
  }

  .publication-title {
    font-size: var(--step-1);
    margin-bottom: var(--space-xs);
  }

  .publication-title a {
    color: var(--navy);
    text-decoration: none;
  }

  .publication-title a:hover,
  .publication-title a:focus {
    color: var(--teal);
    text-decoration: underline;
  }

  .publication-subtitle {
    color: var(--muted);
    font-style: italic;
    margin: var(--space-xs) 0;
  }

  .publication-meta,
  .publication-venue {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0 0 var(--space-s);
  }

  .publication-meta > *:not(:last-child)::after,
  .publication-venue > *:not(:last-child)::after {
    content: " · ";
    color: var(--border);
  }

  .publication-status {
    font-weight: 500;
    color: var(--copper);
  }

  .publication-summary {
    margin-top: var(--space-s);
    color: var(--charcoal);
  }

  .publication-abstract {
    margin-top: var(--space-s);
    color: var(--charcoal);
  }

  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-m);
  }

  .btn--small {
    padding: 0.4em 0.75em;
    font-size: var(--step--1);
  }
</style>
